# API Subito Pizza — protections Apache 2.4 (OVH mutualisé)
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Bibliothèque et outils en ligne de commande : jamais servis (voir aussi lib/.htaccess et tools/.htaccess).
    RewriteRule ^(lib|tools)(/|$) - [F,L]
    # Tout nom commençant par « config », quelle que soit l'extension.
    RewriteRule (^|/)config - [F,L]
    # Fichiers commençant par « _ » (_phpinfo.php, _dbtest.php) et fichiers cachés.
    RewriteRule (^|/)[_.] - [F,L]
    # Documentation, sauvegardes, journaux, exports.
    RewriteRule \.(md|bak|old|orig|swp|txt|sql|log)$ - [F,L]
    RewriteRule ~$ - [F,L]
</IfModule>

# Seconde barrière, même sans mod_rewrite.
<FilesMatch "^(config.*|_.*|\..*|.*\.(md|bak|old|orig|swp|txt|sql|log)|.*~)$">
    Require all denied
</FilesMatch>
