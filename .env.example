# Modèle des variables d'environnement. Ne mettez JAMAIS de vraies valeurs dans ce fichier.
# Vraies valeurs : Vercel > Settings > Environment Variables, et un fichier .env local non versionné.

# Chaîne Postgres du pooleur (Supabase > bouton "Connect" > Transaction pooler, port 6543).
DATABASE_URL=

# Hash bcrypt du code patron : npm run hash-code (le code lui-même ne doit apparaître nulle part).
OWNER_CODE_HASH=

# Hash bcrypt du code « accès supérieur » de l'espace patron (fiches clients, suppression de la recette) :
# npm run hash-code (même outil ; le code lui-même ne doit apparaître nulle part).
SUPER_CODE_HASH=

# Facultatif : origines supplémentaires autorisées pour les requêtes POST (séparées par des virgules),
# par exemple le domaine définitif https://www.subito-pizza-heninbeaumont.fr. L'adresse de déploiement
# Vercel elle-même est toujours autorisée.
APP_ORIGINS=

# NON utilisée par l'API (le code n'a pas besoin de la clé d'administration) : ne la créez pas.
# SUPABASE_SERVICE_ROLE_KEY=
